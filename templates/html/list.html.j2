{% extends "base.html.j2" %}
{% block body %}
<div class="filters">
  {% for f in filters %}
  <span style="font-size:12px;color:var(--text-muted);">{{ f.label }}：</span>
  {% for opt in f.options %}
  <span class="chip {{ 'on' if opt.on else '' }}">{{ opt.text }}</span>
  {% endfor %}
  {% endfor %}
  <span style="flex:1;"></span>
  <span class="btn ghost">导出</span>
  <span class="btn">新建</span>
</div>
<div class="card">
  <h3 class="card-title">{{ table_title }}</h3>
  <table class="data">
    <thead><tr>{% for h in table_headers %}<th>{{ h }}</th>{% endfor %}<th>操作</th></tr></thead>
    <tbody>
    {% for row in table_rows %}
      <tr>
        {% for cell in row %}
        <td>{% if cell.tag %}<span class="tag {{ cell.tag }}">{{ cell.text }}</span>{% else %}{{ cell }}{% endif %}</td>
        {% endfor %}
        <td style="color:var(--primary);">查看 · 编辑</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <div class="pagination">
    共 {{ total }} 条
    <span style="flex:1;"></span>
    <span class="pager">‹</span>
    {% for n in [1, 2, 3, 4, 5] %}
    <span class="pager {{ 'active' if n == 2 else '' }}">{{ n }}</span>
    {% endfor %}
    <span class="pager">›</span>
  </div>
</div>
{% endblock %}
