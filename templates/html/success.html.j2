{% extends "base.html.j2" %}
{% block body %}
<div class="card" style="text-align:center;padding:48px 24px;">
  <div style="width:64px;height:64px;border-radius:50%;background:#d1fae5;display:inline-flex;align-items:center;justify-content:center;margin-bottom:18px;">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
  </div>
  <h2 style="margin:0 0 8px;font-size:22px;">{{ success_title }}</h2>
  <p style="margin:0 0 24px;color:var(--text-muted);">{{ success_desc }}</p>
  <div style="display:inline-flex;gap:10px;">
    <span class="btn subtle">查看详情</span>
    <span class="btn">继续新增</span>
  </div>
  <div style="margin-top:36px;text-align:left;max-width:560px;margin-left:auto;margin-right:auto;background:var(--surface-2);border-radius:8px;padding:16px 20px;">
    <div style="font-size:13px;font-weight:600;margin-bottom:10px;">操作摘要</div>
    {% for item in summary_items %}
    <div style="display:flex;justify-content:space-between;padding:6px 0;font-size:13px;border-top:1px dashed var(--border);">
      <span style="color:var(--text-muted);">{{ item.k }}</span>
      <span>{{ item.v }}</span>
    </div>
    {% endfor %}
  </div>
</div>
<div class="card" style="margin-top:16px;">
  <h3 class="card-title">最近记录</h3>
  <table class="data">
    <thead><tr><th>编号</th><th>名称</th><th>状态</th><th>更新时间</th></tr></thead>
    <tbody>
    {% for row in recent_rows %}
      <tr>
        <td>{{ row[0] }}</td><td>{{ row[1] }}</td>
        <td><span class="tag {{ row[2].tag }}">{{ row[2].text }}</span></td>
        <td>{{ row[3] }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
